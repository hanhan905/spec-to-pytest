{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "integrations/trae/node_modules/@playwright/mcp/cli.js",
        "--isolated", "--codegen", "python",
        "--output-dir", "reports/mcp",
        "--output-max-size", "16777216",
        "--allowed-origins", "http://127.0.0.1:8000;http://localhost:8000",
        "--block-service-workers", "--viewport-size", "1440x900"
      ]
    }
  }
}
