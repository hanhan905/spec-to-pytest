{
  "$defs": {
    "DataReference": {
      "additionalProperties": false,
      "properties": {
        "data_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Data Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "title",
            "content",
            "tags",
            "comment",
            "expected_valid"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "data_id",
        "field"
      ],
      "title": "DataReference",
      "type": "object"
    },
    "ExpectedResult": {
      "additionalProperties": false,
      "properties": {
        "expectation_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Expectation Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "check_ids": {
          "items": {
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Check Ids",
          "type": "array"
        }
      },
      "required": [
        "expectation_id",
        "text",
        "check_ids"
      ],
      "title": "ExpectedResult",
      "type": "object"
    },
    "JsonValue": {},
    "PlannedCase": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "priority": {
          "default": "P1",
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "exploratory_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exploratory Reason"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "data_ids": {
          "items": {
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
            "type": "string"
          },
          "title": "Data Ids",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected_results": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Results",
          "type": "array"
        },
        "automation_candidate": {
          "default": true,
          "title": "Automation Candidate",
          "type": "boolean"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/ExpectedResult"
          },
          "title": "Expectations",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PlannedCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "case_id",
        "title",
        "steps",
        "expected_results"
      ],
      "title": "PlannedCase",
      "type": "object"
    },
    "PlannedCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "subject": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "contains",
            "ordered_equals",
            "count",
            "visible",
            "url_equals",
            "attribute_equals",
            "property_equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "expected_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "subject",
        "operator"
      ],
      "title": "PlannedCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "enum": [
        "2.0",
        "2.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "baseline",
        "synthetic",
        "approved_replay",
        "candidate_replay",
        "trae_orchestrated",
        "trae_single_agent_skill"
      ],
      "title": "Source",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "reduced_scope_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reduced Scope Reason"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/PlannedCase"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "generated_at",
    "source",
    "cases"
  ],
  "title": "TestPlan",
  "type": "object"
}
