{
  "$defs": {
    "PlannedCase": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "priority": {
          "default": "P1",
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "exploratory_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exploratory Reason"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "data_ids": {
          "items": {
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
            "type": "string"
          },
          "title": "Data Ids",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected_results": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Results",
          "type": "array"
        },
        "automation_candidate": {
          "default": true,
          "title": "Automation Candidate",
          "type": "boolean"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "case_id",
        "title",
        "steps",
        "expected_results"
      ],
      "title": "PlannedCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "baseline",
        "synthetic",
        "approved_replay",
        "trae_orchestrated",
        "trae_single_agent_skill"
      ],
      "title": "Source",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "reduced_scope_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reduced Scope Reason"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/PlannedCase"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "generated_at",
    "source",
    "cases"
  ],
  "title": "TestPlan",
  "type": "object"
}
