{
  "$defs": {
    "CaseRunResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,95}$",
          "title": "Case Id",
          "type": "string"
        },
        "nodeid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nodeid"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "repair_attempts": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "passed_after_repair": {
          "default": false,
          "title": "Passed After Repair",
          "type": "boolean"
        },
        "attempt_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "type": "string"
          },
          "title": "Attempt Ids",
          "type": "array"
        },
        "final_reason": {
          "minLength": 1,
          "title": "Final Reason",
          "type": "string"
        },
        "failure_phase": {
          "anyOf": [
            {
              "enum": [
                "setup",
                "call",
                "teardown",
                "mapping",
                "environment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Phase"
        },
        "evidence_paths": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        },
        "artifact_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Unavailable Reason"
        }
      },
      "required": [
        "case_id",
        "status",
        "final_reason"
      ],
      "title": "CaseRunResult",
      "type": "object"
    },
    "CaseStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "blocked"
      ],
      "title": "CaseStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "enum": [
        "2.0",
        "2.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "source": {
      "default": "unrecorded",
      "enum": [
        "baseline",
        "synthetic",
        "candidate_replay",
        "approved_replay",
        "trae_orchestrated",
        "trae_single_agent_skill",
        "unrecorded"
      ],
      "title": "Source",
      "type": "string"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "final_attempt": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Final Attempt",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "quality_gate": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ],
      "title": "Quality Gate",
      "type": "string"
    },
    "planned_count": {
      "minimum": 1,
      "title": "Planned Count",
      "type": "integer"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/CaseStatus"
      },
      "title": "Counts",
      "type": "object"
    },
    "integrity_errors": {
      "items": {
        "type": "string"
      },
      "title": "Integrity Errors",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseRunResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "completed",
    "final_attempt",
    "finished_at",
    "quality_gate",
    "planned_count",
    "counts",
    "integrity_errors",
    "results"
  ],
  "title": "RunManifest",
  "type": "object"
}
